# Copy to `.env` (optional - the defaults below already work for local development).

# Base URL of the FastAPI backend
VITE_API_URL=http://localhost:8000

# Shows one-click demo logins on the login page (only meaningful when the backend seeded demo data).
# Set to false (or remove) for any real deployment.
VITE_SHOW_DEMO_LOGINS=true
VITE_DEMO_PASSWORD=Demo@1234

# Copy this file to `.env` and fill in the blanks. NEVER commit the real `.env`.

# --- PostgreSQL (use URL-safe characters in the password: letters, digits, - and _) ---
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_DB=campusbite

# --- JWT ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenAI (needed only for the AI Order Insights feature) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=10

# --- CORS: comma-separated list of frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173

# --- Background reminder job ---
REMINDER_THRESHOLD_MINUTES=15
REMINDER_INTERVAL_SECONDS=60

# --- Demo data (3 restaurants, 3 owners, 2 delivery partners, 1 customer) ---
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo@1234

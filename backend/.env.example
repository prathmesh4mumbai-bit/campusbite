# Only needed when running the backend WITHOUT Docker (uvicorn directly).
# With Docker Compose, use the .env.example in the repository root instead.
# Copy to `.env` and fill in the blanks. NEVER commit the real `.env`.

# SQLite is the easiest local option; PostgreSQL also works,
# e.g. postgresql+psycopg2://user:password@localhost:5432/campusbite
DATABASE_URL=sqlite:///./campusbite.db

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo@1234
